{
  "name": "website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md,astro}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md,astro}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "type-check": "astro check --tsconfig ./tsconfig.astro.json"
  },
  "dependencies": {
    "@astrojs/check": "~0.9.9",
    "@astrojs/react": "~4.4.2",
    "@astrojs/sitemap": "~3.7.3",
    "@hookform/resolvers": "~5.2.2",
    "@radix-ui/react-accordion": "~1.2.14",
    "@radix-ui/react-avatar": "~1.1.12",
    "@radix-ui/react-checkbox": "~1.3.5",
    "@radix-ui/react-dialog": "~1.1.17",
    "@radix-ui/react-label": "~2.1.10",
    "@radix-ui/react-separator": "~1.1.10",
    "@radix-ui/react-slot": "~1.2.4",
    "@radix-ui/react-tabs": "~1.1.15",
    "@radix-ui/react-tooltip": "~1.2.10",
    "@vibexp/design-system": "^0.1.1",
    "@sentry/astro": "~10.58.0",
    "@sentry/react": "~10.52.0",
    "@sentry/vite-plugin": "~5.2.1",
    "astro": "~6.4.8",
    "class-variance-authority": "~0.7.1",
    "clsx": "~2.1.1",
    "lucide-react": "~0.542.0",
    "react": "~19.2.7",
    "react-dom": "~19.2.7",
    "react-hook-form": "~7.75.0",
    "react-router-dom": "~7.15.1",
    "tailwind-merge": "~3.5.0",
    "tw-animate-css": "~1.4.0",
    "zod": "~4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "~4.11.3",
    "@eslint/js": "~9.33.0",
    "@playwright/test": "~1.59.1",
    "@tailwindcss/postcss": "~4.3.1",
    "@tailwindcss/typography": "~0.5.20",
    "@testing-library/dom": "~10.4.1",
    "@testing-library/jest-dom": "~6.9.1",
    "@testing-library/react": "~16.3.2",
    "@testing-library/user-event": "~14.6.1",
    "@types/jest": "~30.0.0",
    "@types/react": "~19.2.17",
    "@types/react-dom": "~19.2.3",
    "@typescript-eslint/eslint-plugin": "~8.59.4",
    "@typescript-eslint/parser": "~8.59.4",
    "@vitejs/plugin-react": "~5.2.0",
    "astro-eslint-parser": "~1.4.0",
    "autoprefixer": "~10.5.0",
    "eslint": "~9.33.0",
    "eslint-plugin-astro": "~1.7.0",
    "eslint-plugin-react": "~7.37.5",
    "eslint-plugin-react-hooks": "~5.2.0",
    "eslint-plugin-react-refresh": "~0.5.3",
    "globals": "~17.6.0",
    "identity-obj-proxy": "~3.0.0",
    "jest": "~30.4.2",
    "jest-environment-jsdom": "~30.4.1",
    "postcss": "~8.5.15",
    "prettier": "~3.8.4",
    "prettier-plugin-astro": "~0.14.1",
    "tailwindcss": "~4.3.0",
    "ts-jest": "~29.4.11",
    "typescript": "~5.8.3",
    "typescript-eslint": "~8.59.4",
    "vite": "~8.0.16"
  }
}
