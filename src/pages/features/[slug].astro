---
/**
 * One feature page. The words are in features.config.mjs; this is the shape.
 *
 * It is the landing page's argument at a smaller scale and in the same order:
 * the promise, the three costs of the status quo, how it works, the
 * questions. Every block reuses a landing-page component class, so a feature
 * page cannot drift from the design the landing page defines.
 */
import Page from '../../layouts/Page.astro';
import Faq from '../../components/Faq.astro';
import StarCta from '../../components/StarCta.astro';
import JsonLd from '../../components/JsonLd.astro';
import { url, abs, SITE, SITE_NAME, ORG } from '../../../site.config.mjs';
import { FEATURES } from '../../../features.config.mjs';

export function getStaticPaths() {
  return FEATURES.map((feature) => ({ params: { slug: feature.slug }, props: { feature } }));
}

const { feature } = Astro.props;
const faq = feature.faq.map((item: { q: string; a: string; more: string }) => ({
  q: item.q,
  a: item.a,
  more: { label: 'In the docs', path: item.more },
}));

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': abs(`/features/${feature.slug}/`),
    name: feature.title,
    description: feature.description,
    url: abs(`/features/${feature.slug}/`),
    isPartOf: { '@type': 'WebSite', '@id': `${SITE}${url('/')}#website`, name: SITE_NAME },
    about: { '@id': `${SITE}${url('/')}#app` },
    publisher: { '@type': 'Organization', name: ORG.name, url: ORG.url },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Features', item: abs('/features/') },
      { '@type': 'ListItem', position: 2, name: feature.name, item: abs(`/features/${feature.slug}/`) },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((item: { q: string; a: string }) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
];

const [before, accent, after] = feature.h1;
---

<Page title={feature.title} description={feature.description} current="features">
  <JsonLd slot="head" schema={schema} />

  <div class="shell">
    <section class="hero hero--sub">
      <div class="hero__eyebrow">
        <a class="pill pill--plain pill--link" href={url('/features/')}>&#8592; Features</a>
        <span class="pill">{feature.name}</span>
        <span class="pill pill--plain">{feature.eyebrow}</span>
      </div>
      <h1 class="hero__title">{before}<em>{accent}</em>{after}</h1>
      <p class="hero__lede">{feature.lede}</p>
      <div class="hero__cta">
        <a class="btn btn--primary" href={url('/#install')}>Run VibeXP &#8594;</a>
        <a class="btn" href={url(feature.docs)}>Read the docs</a>
      </div>
    </section>

    <section class="section">
      <div class="section__head">
        <h2>The problem.</h2>
        <span class="label">Without it</span>
      </div>
      <div class="pains">
        {feature.pains.map((pain: { h: string; p: string }, i: number) => (
          <div class="sheet sheet--dashed pain">
            <span class="pain__n">{String(i + 1).padStart(2, '0')}</span>
            <h4>{pain.h}</h4>
            <p>{pain.p}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="section">
      <div class="section__head">
        <h2>How it works.</h2>
        <span class="label">{feature.name}</span>
      </div>
      <div class="split">
        {feature.panels.map((panel: any) => (
          <div class="sheet panel">
            <div class="eyebrow">
              {panel.eyebrow}
              <span class="eyebrow__end"><a href={url(panel.more.path)}>{panel.more.label} &#8599;</a></span>
            </div>
            <h3>{panel.h}</h3>
            <p>{panel.p}</p>
            <ul>
              {panel.list.map(([b, rest]: [string, string]) => (
                <li><b>{b}</b> {rest}</li>
              ))}
            </ul>
            <pre class="codeblock panel__code">{panel.code.map((line: [string, string?][], i: number) => (
              <>{i > 0 && '\n'}{line.map(([t, c]) => (c ? <span class={c}>{t}</span> : t))}</>
            ))}</pre>
          </div>
        ))}
      </div>
    </section>

    <Faq items={faq} />

    <StarCta />

    <section class="closer">
      <h2>{feature.closer}</h2>
      <p>
        Free, open source and self-hosted. One command to run it, one to connect your AI tools, and
        everything else in the docs.
      </p>
      <div class="hero__cta">
        <a class="btn btn--primary" href={url('/#install')}>Run VibeXP &#8594;</a>
        <a class="btn btn--ghost" href={url('/features/')}>Every feature</a>
      </div>
    </section>
  </div>
</Page>
