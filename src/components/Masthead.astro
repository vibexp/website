---
import { url, REPO } from '../../site.config.mjs';
import ThemeToggle from './ThemeToggle.astro';
import repo from '../data/repo.json';

// Same threshold as StarCta: below it the number weakens the ask.
const stars = repo.resolved && repo.stars !== null && repo.stars >= 100
  ? new Intl.NumberFormat('en', { notation: 'compact' }).format(repo.stars)
  : null;

interface Props { current?: 'features' | 'how' | 'docs' | 'blog' }
const { current } = Astro.props;
---
<header class="masthead">
  <div class="masthead__in">
    <a class="wordmark" href={url('/')}><span class="wordmark__dot"></span>VibeXP</a>
    <nav class="nav">
      <a href={url('/features/')} aria-current={current === 'features' ? 'page' : undefined}>Features</a>
      <a href={url('/how-it-works/')} aria-current={current === 'how' ? 'page' : undefined}>How it works</a>
      <a href={url('/docs/')} aria-current={current === 'docs' ? 'page' : undefined}>Docs</a>
      <a href={url('/blog/')} aria-current={current === 'blog' ? 'page' : undefined}>Blog</a>
      <a class="navbtn navstar" href={REPO}><span aria-hidden="true">&#9733;</span> Star{stars && <span class="n">{stars}</span>}</a>
      <ThemeToggle />
    </nav>
  </div>
</header>
