---
/**
 * The shell for every page Starlight does not own: the landing page, the blog
 * and the 404. Starlight builds its own <head>, so anything that must be true
 * of *both* halves of the site (fonts, tokens, the theme attribute, the consent
 * banner) is imported here and passed to Starlight through `customCss` in
 * astro.config.mjs.
 */
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/site.css';
import '../styles/consent.css';
import Masthead from '../components/Masthead.astro';
import Foot from '../components/Foot.astro';
import { url, abs, OG_IMAGE, SITE_NAME, gtmId, gtmSnippet, consentDefaultSnippet, consentBannerSnippet } from '../../site.config.mjs';

interface Props {
  title: string;
  description: string;
  current?: 'features' | 'how' | 'docs' | 'blog';
  ogType?: string;
  /** A page-specific share image, site-absolute. Falls back to the site card. */
  image?: { path: string; alt: string; width?: number; height?: number };
}
const { title, description, current, ogType = 'website', image } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

// Absolute, because a scraper resolves it with no page context. The alt text
// describes the card rather than repeating the title: a screen reader that has
// just read the title should not hear it twice.
const card = image ?? OG_IMAGE;
const ogImage = abs(card.path);
const gtm = gtmId();
---
<!doctype html>
{/* `ink`, the accent-free pick: VibeXP's brand is monochrome, so near-black
    does every job the sibling sites give to their green. See the design
    system's tokens/accents.css. */}
<html lang="en" data-accent="ink">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="alternate" type="application/rss+xml" title="VibeXP blog" href={url('/rss.xml')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_NAME} />
    {/* No og:locale. Starlight derives its own from the locale config and emits
        a bare `en`; spelling a second one here would mean the two halves
        disagreed about the same page's language for the sake of a tag whose
        absence costs nothing. */}
    <meta property="og:image" content={ogImage} />
    {card.width && <meta property="og:image:width" content={String(card.width)} />}
    {card.height && <meta property="og:image:height" content={String(card.height)} />}
    <meta property="og:image:alt" content={card.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <slot name="head" />
    {/* Consent Mode's defaults must be in the dataLayer BEFORE the container
        loads, so these three are one ordered group: default, container,
        banner. Keep them adjacent and keep them in this order. */}
    {gtm && <script is:inline set:html={consentDefaultSnippet()} />}
    {gtm && <script is:inline set:html={gtmSnippet(gtm)} />}
    {gtm && <script is:inline set:html={consentBannerSnippet(url('/docs/user-guide/self-hosting/'))} />}
    <script is:inline>
      // Applied before first paint so a dark-mode visitor never sees a flash
      // of the paper ground. The key is Starlight's own, so a choice made here
      // survives into the docs and back.
      (() => {
        const t = localStorage.getItem('starlight-theme');
        if (t === 'dark' || t === 'light') document.documentElement.setAttribute('data-theme', t);
      })();
    </script>
  </head>
  <body>
    <Masthead current={current} />
    <slot />
    <div class="shell"><Foot /></div>
  </body>
</html>
